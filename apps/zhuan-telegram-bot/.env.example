# BOT_TOKEN comes from BotFather.
BOT_TOKEN=replace_with_your_botfather_token

# ALLOWED_USER_ID is Zhuan's numeric Telegram user ID, not the bot username.
# First run: keep this empty, start the bot, send /whoami, then paste the number here.
ALLOWED_USER_ID=

# Keep legacy 08_Logs Markdown writes during V1 stabilization.
LEGACY_MARKDOWN_FALLBACK=true
